# ---------------------------------------------------------------------------
# Model backend
# ---------------------------------------------------------------------------
# "ollama" (default, self-hosted, no API cost) or "anthropic".
LLM_PROVIDER=ollama

# --- Ollama ----------------------------------------------------------------
# The Ollama host. Remote hosts must be started with OLLAMA_HOST=0.0.0.0 and
# have TCP 11434 open, otherwise Ollama only listens on 127.0.0.1.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Recommended for a 24 GB GPU (~20 GB usable). See README for measurements —
# weights + KV cache must fit, or the driver silently spills to system RAM and
# generation gets ~7x slower while still reporting 100% GPU-resident.
# gpt-oss:20b uses only 12.0 GB at num_ctx=32768, leaving ample headroom.
OLLAMA_MODEL=gpt-oss:20b

# Model for the lighter calls (CV polish, profile merge). Defaults to
# OLLAMA_MODEL. Leave it unset unless both models fit in VRAM simultaneously —
# otherwise Ollama evicts and reloads between calls, which costs far more time
# than the smaller model saves.
# OLLAMA_MODEL_FAST=qwen3:8b

# Context window. Ollama defaults to 4096 and SILENTLY truncates beyond it;
# this app sends 8k-15k tokens, so it must be set explicitly.
OLLAMA_NUM_CTX=32768

# How long Ollama keeps the model in VRAM after a request.
OLLAMA_KEEP_ALIVE=30m

# Per-request timeout (ms). Local generation is much slower than a hosted API.
OLLAMA_TIMEOUT_MS=600000

# Reasoning effort: "low" | "medium" | "high", or unset for the model default.
# Reasoning models emit thinking tokens BEFORE any answer, and num_predict caps
# the two combined — so a high effort level costs a lot of latency here, and a
# small token budget can be consumed entirely by thinking (empty response).
# Measured with gpt-oss:20b: "low" cut /api/analyze 22.8s -> 9.4s and
# /api/tailor 37.9s -> 3.8s with no loss of output quality.
#
# WARNING: do NOT set "false" with gpt-oss — it crashes the llama-server
# subprocess ("CUDA error: shared object initialization failed") and takes the
# model host down until it restarts. Use "low" to minimize reasoning instead.
OLLAMA_THINK=low

# --- Anthropic (only when LLM_PROVIDER=anthropic) ---------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-7
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# ---------------------------------------------------------------------------
# LaTeX rendering (optional)
# ---------------------------------------------------------------------------
# Used to compile drafts and count real PDF pages. Defaults to the public
# YtoTech instance. Point this at a self-hosted compiler to keep résumé LaTeX
# entirely on your own infrastructure.
# LATEX_RENDER_URL=https://latex.ytotech.com/builds/sync

# ---------------------------------------------------------------------------
# API access control (optional)
# ---------------------------------------------------------------------------
# Shared secret required by every /api/* route. UNSET = no auth check, which
# is the right default for a localhost-only dev server.
#
# Set this if you follow the README's "use it from your phone" instructions
# and bind the dev server to 0.0.0.0. At that point anything else on the
# network can reach two open proxies: /api/render forwards your résumé to a
# third-party LaTeX compiler, and /api/analyze spends your GPU.
#
# Clients send it as either header:
#   x-app-token: <value>
#   Authorization: Bearer <value>
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#
# NOTE: this is a deterrent for a home LAN, not authentication. Over plain
# HTTP the token travels in cleartext. Anything genuinely public belongs
# behind a real reverse proxy with TLS.
# APP_ACCESS_TOKEN=

# Rate limiting is always on for the two expensive routes and needs no
# configuration: /api/analyze is capped at 30 requests/minute per IP and
# /api/render at 60/minute. The counters are in-process, so they reset when
# the server restarts and are not shared across instances. See lib/rate-limit.ts.
